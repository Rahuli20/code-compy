# Cloud env (copy to .env.local)

# Required for mutating requests (POST / PATCH / DELETE)
NAV_ADMIN_SECRET=change-me

# Optional: pin CORS to your published domain(s) in addition to defaults
# NAV_ALLOWED_ORIGIN=https://your-site.com

# --- Webflow CMS mode (recommended for production) ---
# Create a CMS collection (see root README) then set:
# WEBFLOW_NAV_COLLECTION_ID=...
# WEBFLOW_SITE_API_TOKEN=...   # Site token with CMS read/write

# If WEBFLOW_NAV_COLLECTION_ID is omitted, the API uses an in-memory store (dev/demo only).
